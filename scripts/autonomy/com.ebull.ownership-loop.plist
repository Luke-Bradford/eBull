<?xml version="1.0" encoding="UTF-8"?>
<!--
  eBull ownership/filings headless loop.

  Install (once) — driver copy FIRST, then the agent:
    mkdir -p /Users/lukebradford/Dev/.ebull-ownership/var/autonomy/bin
    cp scripts/autonomy/ta_loop.sh \
       /Users/lukebradford/Dev/.ebull-ownership/var/autonomy/bin/

  ⚠ The DRIVER is the only file copied. `TA_LOOP_PROMPT` below names the
  installed path; the driver derives its canonical source from that filename
  (`origin/main:scripts/autonomy/ownership_loop_prompt.md`) and re-materialises
  it every iteration, so a merged prompt edit reaches the loop with no
  re-bootstrap (#2658). Override with TA_LOOP_PROMPT_SOURCE if that moves.
    cp scripts/autonomy/com.ebull.ownership-loop.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ebull.ownership-loop.plist

  ⚠ launchd runs the copy under var/autonomy/bin/, NOT the tracked script.
  The driver drives a worktree whose branch changes every iteration, so a
  driver read from a tracked path is deleted by its own `git checkout` the
  first time the loop branches off a commit older than this one. `/var/*` is
  gitignored, so the installed copy is invisible to every checkout.
  Re-copy it after any change to ta_loop.sh — the tracked file is the source,
  the installed file is what runs.

  ⚠ This plist is a LOCAL-MACHINE artefact and its absolute paths and username
  are deliberate, not an oversight: launchd requires absolute paths, offers no
  variable expansion in ProgramArguments, and this loop drives one specific
  worktree on one specific Mac. It is committed for provenance and recovery,
  not for reuse. Anyone else: change the four paths, or drive it by hand with
  TA_LOOP_WORKTREE.

  Stop it gracefully (finishes the current iteration, then idles):
    touch /Users/lukebradford/Dev/.ebull-ownership/var/autonomy/PAUSE

  Stop it entirely:
    launchctl bootout gui/$(id -u)/com.ebull.ownership-loop

  Check on it (both loops, or one):
    scripts/autonomy/loop_status.sh
    scripts/autonomy/loop_status.sh ownership

  ⚠ SAME DRIVER, DIFFERENT PROMPT. `ta_loop.sh` is loop-agnostic — worktree,
  state directory and prompt are all env-driven, and the single-instance lock
  lives at `$TA_LOOP_STATE/loop.lock`, so this agent and the TA one cannot
  collide. `TA_LOOP_PROMPT` below is what makes this loop an ownership loop;
  without it the driver would read `ta_loop_prompt.md` next to itself and both
  loops would race for the same tickets.

  ⚠ KeepAlive is TRUE so a crashed iteration restarts, but the driver itself
  stops after 3 consecutive failures. That pairing is deliberate: launchd
  handles "the process died", the driver handles "the work keeps failing", and
  neither pretends to do the other's job. The previous loop conflated them and
  spun on a wedged state file for two weeks.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ebull.ownership-loop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/lukebradford/Dev/.ebull-ownership/var/autonomy/bin/ta_loop.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/lukebradford/Dev/.ebull-ownership</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Homebrew first: `claude` and `uv` both live there. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- A pause between iterations so a fast-failing loop cannot hammer
             the API or the review bot. Longer than ta_loop.sh's own 60s
             default (TA_LOOP_COOLDOWN in the script) on purpose: unattended
             runs get twice the backoff a supervised one does. If the script's
             default changes, this stays as-is unless the reason above changes
             with it. -->
        <key>TA_LOOP_COOLDOWN</key>
        <string>120</string>
        <!-- ⚠ REQUIRED, and not implied by WorkingDirectory. `ta_loop.sh`
             defaults TA_LOOP_WORKTREE to the TA worktree, and the state dir
             (and therefore the lock) is derived from it — so without this the
             ownership agent drives the TA loop's checkout. Observed exactly
             that on first bootstrap: three `ABORT another ta_loop.sh holds
             .../.ebull-autonomy/var/autonomy/loop.lock` in 21 seconds, one per
             KeepAlive respawn. The lock did its job; the plist was wrong. -->
        <key>TA_LOOP_WORKTREE</key>
        <string>/Users/lukebradford/Dev/.ebull-ownership</string>
        <!-- What makes this the ownership loop rather than a second TA one. -->
        <key>TA_LOOP_PROMPT</key>
        <string>/Users/lukebradford/Dev/.ebull-ownership/var/autonomy/bin/ownership_loop_prompt.md</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- ⚠ Not piped anywhere. The driver's own log is the record; these catch
         anything that escapes it (a bad PATH, a missing binary) which is
         precisely the class of failure that leaves no application-level trace. -->
    <key>StandardOutPath</key>
    <string>/Users/lukebradford/Dev/.ebull-ownership/var/autonomy/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lukebradford/Dev/.ebull-ownership/var/autonomy/launchd.err.log</string>
</dict>
</plist>
