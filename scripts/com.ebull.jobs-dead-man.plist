<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd LaunchAgent for the jobs dead-man (#3614 item 3).

  Wire once (see docs/operator/runbooks/jobs-dead-man.md):
    1. Replace __REPO__ with the absolute eBull checkout path and __NTFY_TOPIC__
       with your private ntfy topic (or delete that key to run without push).
    2. Install to ~/Library/LaunchAgents/com.ebull.jobs-dead-man.plist
    3. launchctl load ~/Library/LaunchAgents/com.ebull.jobs-dead-man.plist

  A one-shot every 300 s (StartInterval), not a long-lived loop: launchd itself
  re-fires it, so a crashed run cannot silence the next one. State between runs
  lives in ~/.cache/ebull/jobs_dead_man_status.json.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ebull.jobs-dead-man</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>-m</string>
        <string>scripts.jobs_dead_man</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>EBULL_NTFY_TOPIC</key>
        <string>__NTFY_TOPIC__</string>
    </dict>

    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>__REPO__/var/log/jobs-dead-man.log</string>
    <key>StandardOutPath</key>
    <string>__REPO__/var/log/jobs-dead-man.log</string>
</dict>
</plist>
